# Copia este archivo como .env y completa solo el proveedor que usarás.
# Nunca confirmes .env ni claves reales en Git.

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Consulta los catálogos oficiales antes de elegir identificadores:
# https://developers.openai.com/api/docs/models
# https://ai.google.dev/gemini-api/docs/models
OPENAI_MODEL=replace-with-a-current-model-id
GEMINI_MODEL=replace-with-a-current-model-id

# Embeddings de OpenAI usados por los ejemplos compatibles.
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Límites locales: ajusta tras revisar cuota y precios del proveedor.
MAX_TOKENS_PER_REQUEST=4000
TEMPERATURE_DEFAULT=0.7
ENABLE_CACHING=true

# Servicios opcionales usados por ejercicios específicos.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# MONGODB_URI=mongodb://localhost:27017/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
